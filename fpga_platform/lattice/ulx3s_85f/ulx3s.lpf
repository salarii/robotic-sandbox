# Clock: 25 MHz onboard crystal oscillator
LOCATE COMP "clk" SITE "G2";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25.0 MHz;

# Reset buttons (active-high; pulled down so inactive when not pressed)
# FIRE1 button (R1) -> rst
LOCATE COMP "rst" SITE "R1";
IOBUF PORT "rst" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# FIRE2 button (T1) -> debug_reset
LOCATE COMP "debug_reset" SITE "T1";
IOBUF PORT "debug_reset" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# CP2102 UART on Header J1 (Silkscreen '0')
# FPGA TX (out) -> CP2102 RXD: J1 Row 3 Left pin (gp[0] / B11)
LOCATE COMP "uart_tx_o" SITE "B11";
IOBUF PORT "uart_tx_o" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# CP2102 TXD (out) -> FPGA RX (in): J1 Row 3 Right pin (gn[0] / C11)
LOCATE COMP "uart_rx_i" SITE "C11";
IOBUF PORT "uart_rx_i" PULLMODE=UP IO_TYPE=LVCMOS33;

# VexRiscv JTAG mapped to LCD1 Header
# Physical layout from bottom to top: GND, VCC, SCL, SDA, RES, DC

# TCK -> Plug into SCL (Internal Pull-Down) brown
LOCATE COMP "jtag_tck" SITE "P4"; 
IOBUF PORT "jtag_tck" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# TMS -> Plug into SDA (Internal Pull-Up) green 
LOCATE COMP "jtag_tms" SITE "P3"; 
IOBUF PORT "jtag_tms" PULLMODE=UP IO_TYPE=LVCMOS33;

# TDI -> Plug into RES (Internal Pull-Up) white 
LOCATE COMP "jtag_tdi" SITE "P2"; 
IOBUF PORT "jtag_tdi" PULLMODE=UP IO_TYPE=LVCMOS33;

# TDO -> Plug into DC (No pull needed, FPGA drives this) orange
LOCATE COMP "jtag_tdo" SITE "P1"; 
IOBUF PORT "jtag_tdo" PULLMODE=NONE IO_TYPE=LVCMOS33;


# I2C external pins for ADS1115 (Header J1, Silkscreen Row '1')
# SCL -> J1 Row '1' Left pin (gp[1] / A10)
LOCATE COMP "i2c_scl" SITE "A10"; 
IOBUF PORT "i2c_scl" PULLMODE=NONE IO_TYPE=LVCMOS33;

# SDA -> J1 Row '1' Right pin (gn[1] / A11)
LOCATE COMP "i2c_sda" SITE "A11"; 
IOBUF PORT "i2c_sda" PULLMODE=NONE IO_TYPE=LVCMOS33;